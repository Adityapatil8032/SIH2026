# ==============================================================================
# APNA ROUTE — Environment Variables Configuration
# ==============================================================================

# 1. Gemini AI API Key (Required for AI Trip Planner & AI Concierge)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Canonical Application URL (Optional on Vercel)
# On Vercel, this is auto-detected via VERCEL_URL / https headers.
# Set this if you use a custom domain (e.g. https://apnaroute.com or https://your-project.vercel.app)
APP_URL=

# 3. Google OAuth 2.0 Credentials (Required for Google Sign-In)
# Get credentials at: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: https://your-project.vercel.app (and http://localhost:3000)
# Authorized Redirect URIs:       https://your-project.vercel.app/auth/callback (and http://localhost:3000/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Also accessible by frontend if prefixed with VITE_:
VITE_GOOGLE_CLIENT_ID=

# 4. JWT Authentication Secret Key (Required for secure session signing)
# Set any random 32+ character string (e.g. openssl rand -hex 32)
AUTH_JWT_SECRET=apna_route_jwt_super_secure_secret_production_2026

# 5. Database Options (Choose MongoDB or Supabase, or use memory fallback)
# Option A: MongoDB Atlas (Recommended for cloud persistence)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/apnaroute?retryWrites=true&w=majority
MONGODB_URI=

# Option B: Supabase (Free PostgreSQL database)
SUPABASE_URL=
SUPABASE_ANON_KEY=

